# Local development: leave DATABASE_URL empty to use SQLite in ./instance/laundry.db
# Production: paste the PostgreSQL connection URI copied from Supabase Dashboard > Connect.
# Prefer Supabase's shared Session Pooler connection (usually port 5432) for Render.
DATABASE_URL=

# Use a unique random value in production. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret

# Set these on Render for the first deployment only; password must be at least 12 characters.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=مدير النظام
INITIAL_ADMIN_PASSWORD=change-this-to-a-unique-12-plus-character-password

# Optional local setting
# DATABASE_PATH=instance/laundry.db
